{
  "name": "jinggu",
  "version": "1.0.0",
  "private": true,
  "description": "A simple, yet exciting, 2D multiplayer game bedrock made using only typescript, HTML canvas, socket.io, and some infinite loops",
  "main": "index.js",
  "workspaces": [
    "client",
    "server",
    "shared",
    "map-editor",
    "sprite-editor"
  ],
  "scripts": {
    "start": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "start:server": "npm -w server run dev",
    "start:client": "npm -w client run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielsiedler/Jinggu.git"
  },
  "keywords": [
    "game",
    "engine",
    "tibia"
  ],
  "author": "Gabriel Siedler",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gabrielsiedler/Jinggu/issues"
  },
  "homepage": "https://github.com/gabrielsiedler/Jinggu#readme",
  "dependencies": {
    "concurrently": "^9.0.0"
  }
}
